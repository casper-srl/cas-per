---
import "../styles/global.css";
import MarketingTracking from "../components/MarketingTracking.astro";
import { primaryCtaLabel, whatsappHref } from "../data/contact";

const {
  title = "Cas-Per | Tecnologia e relazione per imprese funebri",
  description = "Cas-Per accompagna le imprese funebri con soluzioni digitali su misura: AnnunciFunebri.it, siti web, app, WhatsApp, streaming, monitor e assistenza diretta.",
  canonical,
  image = "/assets/annuncifunebri_pc-1.jpg",
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImageUrl = new URL(image, Astro.site ?? Astro.url.origin).toString();
const buildSha = import.meta.env.PUBLIC_BUILD_SHA || "local";

const nav = [
  { href: "/", label: "Home" },
  { href: "/chi-siamo/", label: "Chi siamo" },
  { href: "/annuncifunebri/", label: "AnnunciFunebri.it" },
  {
    href: "/soluzioni/",
    label: "Soluzioni",
    children: [
      { href: "/soluzioni/annunci-funebri-necrologi/", label: "Annunci e cordogli" },
      { href: "/soluzioni/monitor-case-funerarie/", label: "Monitor case funerarie" },
      { href: "/soluzioni/streaming-cerimonia/", label: "Streaming cerimonia" },
      { href: "/soluzioni/siti-web-app-imprese-funebri/", label: "Siti web e app" },
      { href: "/soluzioni/gestionale-eterno/", label: "Gestionale Eterno" },
      { href: "/soluzioni/editor-grafico-giotto/", label: "Editor Giotto" },
    ],
  },
  { href: "/eventi/", label: "rip-party" },
  { href: "/news/", label: "News" },
  { href: "/dicono-di-noi/", label: "Dicono di noi" },
  { href: "/contatti/", label: "Contatti" },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Cas-Per — News" href="/rss.xml" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Cas-Per" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="casper-build-sha" content={buildSha} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <MarketingTracking />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Cas-Per home">
        <img class="brand-logo" src="/assets/logo-casper-glass-transparent.webp" alt="Cas-Per" />
      </a>
      <button class="mobile-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="sr-only">Apri menu</span>
      </button>
      <p class="rail-claim">Tecnologia, relazione, memoria.</p>
      <nav id="site-navigation" class="site-nav" aria-label="Navigazione principale">
        {
          nav.map((item) =>
            item.children ? (
              <details class:list={["nav-group", isActive(item.href) && "active"]}>
                <summary class={isActive(item.href) ? "active" : ""}>{item.label}</summary>
                <div class="sub-nav" aria-label={`Sottopagine ${item.label}`}>
                  <a class={currentPath === item.href ? "active" : ""} href={item.href}>Tutte le soluzioni</a>
                  {item.children.map((child) => (
                    <a class={isActive(child.href) ? "active" : ""} href={child.href}>{child.label}</a>
                  ))}
                </div>
              </details>
            ) : (
              <a class={isActive(item.href) ? "active" : ""} href={item.href}>{item.label}</a>
            )
          )
        }
      </nav>
      <div class="rail-human">
        <div class="human-stack" aria-hidden="true">
          <span>C</span>
          <span>P</span>
        </div>
        <p><strong>Informazioni su misura.</strong> Ti ascoltiamo e capiamo insieme quali soluzioni possono esserti utili.</p>
        <a href={whatsappHref}>{primaryCtaLabel}</a>
      </div>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/" aria-label="Cas-Per home">
          <img class="brand-logo footer-logo" src="/assets/logo-casper-glass-transparent.webp" alt="Cas-Per" />
        </a>
        <p>Tecnologia e relazione per l'evoluzione digitale delle imprese funebri.</p>
      </div>
      <div class="footer-links">
        <a href="mailto:info@cas-per.it">info@cas-per.it</a>
        <a href="tel:+393408384217">+39 340 838 4217</a>
        <a href={whatsappHref}>{primaryCtaLabel}</a>
        <a href="https://www.iubenda.com/privacy-policy/88572891" target="_blank" rel="noopener">Privacy policy</a>
        <a href="https://www.iubenda.com/privacy-policy/88572891/cookie-policy" target="_blank" rel="noopener">Cookie policy</a>
        <a href="#" class="iubenda-cs-preferences-link">Preferenze cookie</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const mobileNav = window.matchMedia("(max-width: 1060px)");
        const header = document.querySelector(".site-header");
        const toggle = document.querySelector(".mobile-menu-toggle");
        const nav = document.querySelector("#site-navigation");
        const groups = document.querySelectorAll(".site-nav details.nav-group");

        const closeMobileGroups = () => {
          if (!mobileNav.matches) return;
          groups.forEach((group) => {
            group.open = false;
          });
        };

        const setMenuOpen = (isOpen) => {
          header?.classList.toggle("menu-open", isOpen);
          toggle?.setAttribute("aria-expanded", String(isOpen));
          toggle?.setAttribute("aria-label", isOpen ? "Chiudi menu" : "Apri menu");
          document.documentElement.classList.toggle("mobile-menu-open", isOpen);
          document.body.classList.toggle("mobile-menu-open", isOpen);
        };

        closeMobileGroups();
        setMenuOpen(false);

        toggle?.addEventListener("click", () => {
          setMenuOpen(!header?.classList.contains("menu-open"));
        });

        nav?.addEventListener("click", (event) => {
          const target = event.target;
          if (target instanceof HTMLAnchorElement && mobileNav.matches) {
            setMenuOpen(false);
          }
        });

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setMenuOpen(false);
        });

        window.addEventListener("pageshow", closeMobileGroups);
        mobileNav.addEventListener?.("change", () => {
          closeMobileGroups();
          setMenuOpen(false);
        });

        const footer = document.querySelector(".site-footer");
        if (footer && "IntersectionObserver" in window) {
          const footerObserver = new IntersectionObserver(([entry]) => {
            document.body.classList.toggle("footer-in-view", entry.isIntersecting);
          }, { threshold: 0.01 });
          footerObserver.observe(footer);
        }

        document.addEventListener("click", (event) => {
          const link = event.target instanceof Element ? event.target.closest("a") : null;
          if (!(link instanceof HTMLAnchorElement)) return;

          const href = link.href;
          const channel = href.includes("wa.me/")
            ? "whatsapp"
            : href.startsWith("tel:")
              ? "telefono"
              : href.startsWith("mailto:")
                ? "email"
                : null;

          if (!channel) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "contact_click",
            contact_channel: channel,
            link_text: link.textContent?.trim() ?? "",
            page_path: window.location.pathname,
          });
        });
      })();
    </script>
  </body>
</html>
