---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { primaryCtaLabel, primaryCtaNote, whatsappHref } from "../data/contact";
---

<BaseLayout title="Contatti | Cas-Per">
  <div class="glass-bg-blobs" aria-hidden="true">
    <div class="blob-circle blob-cyan" style="top: 10%; left: 5%; width: 420px; height: 420px; opacity: 0.15;"></div>
    <div class="blob-circle blob-mauve" style="top: 35%; right: 5%; width: 340px; height: 340px; opacity: 0.12;"></div>
    <div class="blob-circle blob-powder" style="bottom: 10%; left: 10%; width: 380px; height: 380px; opacity: 0.15;"></div>
  </div>

  <PageHero eyebrow="Contatti" title="Parliamo della tua impresa." text="Niente percorsi automatici: preferiamo ascoltare come lavori e capire insieme quali soluzioni possono esserti davvero utili." />

  <section class="section">
    <div class="section-inner split visual-split">
      <div class="contact-card future-card teal-card" style="grid-column: span 1;">
        <span>Vai incontro al futuro</span>
        <h2 style="margin-top: 10px; margin-bottom: 14px; font-size: 1.85rem;">Una proposta costruita sul modo in cui lavori.</h2>
        <p style="margin-bottom: 24px;">
          Ti ascoltiamo, capiamo le esigenze e prepariamo una proposta su misura.
        </p>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 30px;">
          <a href={whatsappHref} style="display: block; text-decoration: none; color: inherit;">
            <strong style="color: var(--teal-deep); display: block; font-size: 1rem; margin: 0 0 4px 0;">WhatsApp</strong>
            <span style="font-size: 0.88rem; color: var(--soft-ink);">Scrivici direttamente</span>
          </a>
          <a href="tel:+393408384217" style="display: block; text-decoration: none; color: inherit;">
            <strong style="color: var(--teal-deep); display: block; font-size: 1rem; margin: 0 0 4px 0;">Telefono</strong>
            <span style="font-size: 0.88rem; color: var(--soft-ink);">+39 340 838 4217</span>
          </a>
          <a href="mailto:info@cas-per.it" style="display: block; text-decoration: none; color: inherit;">
            <strong style="color: var(--teal-deep); display: block; font-size: 1rem; margin: 0 0 4px 0;">Email</strong>
            <span style="font-size: 0.88rem; color: var(--soft-ink);">info@cas-per.it</span>
          </a>
          <div style="display: block;">
            <strong style="color: var(--teal-deep); display: block; font-size: 1rem; margin: 0 0 4px 0;">Sede</strong>
            <span style="font-size: 0.88rem; color: var(--soft-ink);">Tarcento (UD), Italia</span>
          </div>
        </div>
        <a class="button primary" href={whatsappHref} style="width: 100%;">{primaryCtaLabel}</a>
        <p class="cta-note" style="text-align: center;">{primaryCtaNote}</p>
      </div>
      <div class="asset-panel contact-asset-panel" style="grid-column: span 1;">
        <div class="glass-bg-blobs" aria-hidden="true">
          <div class="blob-circle blob-mauve" style="width: 250px; height: 250px; top: 15%; right: 15%; opacity: 0.18;"></div>
        </div>
        <img
          class="contact-asset-image"
          src="/assets/contatti-casper-trasparente.webp"
          alt="Telefono, smartphone e strumenti di contatto Cas-Per"
        />
      </div>
    </div>
  </section>

  <section class="section muted configurator-section">
    <div class="section-inner configurator-grid">
      <div>
        <p class="eyebrow">Soluzioni su misura</p>
        <h2>Ogni proposta nasce dal modo in cui lavora la tua impresa.</h2>
        <p class="lead small-lead">
          Ogni agenzia ha volumi, abitudini e servizi diversi. Per questo partiamo dalle esigenze reali e costruiamo
          una soluzione proporzionata, chiara e sostenibile.
        </p>
      </div>
      <div class="configurator" data-contact-configurator>
        <label class="range-label" for="contactServicesRange">
          <span>Servizi funebri annui</span>
          <strong data-service-output>150</strong>
        </label>
        <input id="contactServicesRange" type="range" min="50" max="350" step="50" value="150" data-service-range />
        <div class="module-grid" aria-label="Soluzioni di interesse">
          <label class="module-toggle">
            <input type="checkbox" value="Annunci funebri online" checked />
            <span>Annunci funebri</span>
          </label>
          <label class="module-toggle">
            <input type="checkbox" value="Monitor e vetrine" />
            <span>Monitor</span>
          </label>
          <label class="module-toggle">
            <input type="checkbox" value="Sito web o app" checked />
            <span>Sito/App</span>
          </label>
          <label class="module-toggle">
            <input type="checkbox" value="Streaming cerimonie" />
            <span>Streaming</span>
          </label>
        </div>
        <div class="config-summary">
          <p data-config-summary>
            La tua impresa gestisce circa 150 servizi e vuole integrare Annunci funebri online, Sito web o app.
          </p>
          <a class="button primary" data-config-cta href={whatsappHref}>{primaryCtaLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const contactConfigurator = document.querySelector("[data-contact-configurator]");
    const contactRange = contactConfigurator?.querySelector("[data-service-range]");
    const contactOutput = contactConfigurator?.querySelector("[data-service-output]");
    const contactSummary = contactConfigurator?.querySelector("[data-config-summary]");
    const contactCta = contactConfigurator?.querySelector("[data-config-cta]");
    const contactModules = Array.from(contactConfigurator?.querySelectorAll(".module-toggle input") ?? []);

    const updateContactConfigurator = () => {
      if (!contactRange || !contactOutput || !contactSummary || !contactCta) return;
      const services = contactRange.value;
      const selected = contactModules.filter((input) => input.checked).map((input) => input.value);
      const needs = selected.length ? selected.join(", ") : "un primo orientamento";
      contactOutput.textContent = services;
      contactSummary.textContent = `La tua impresa gestisce circa ${services} servizi e vuole integrare ${needs}. Possiamo costruire una proposta su misura per rendere più semplice la comunicazione e più curata l'esperienza delle famiglie.`;
      contactCta.href = `https://wa.me/393408384217?text=${encodeURIComponent(`Ciao, vorrei una proposta Cas-Per su misura. Gestiamo circa ${services} servizi annui e ci interessano: ${needs}.`)}`;
    };

    contactRange?.addEventListener("input", updateContactConfigurator);
    contactModules.forEach((input) => input.addEventListener("change", updateContactConfigurator));
    updateContactConfigurator();
  </script>
</BaseLayout>
