---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const categoryDefinitions = [
  {
    key: "notizie",
    label: "Notizie",
    aliases: ["news", "notizia", "notizie", "approfondimento", "approfondimenti"],
  },
  { key: "eventi", label: "Eventi", aliases: ["evento", "eventi"] },
  { key: "guide", label: "Guide", aliases: ["guida", "guide"] },
];

const normalizeCategory = (category: string) => category.trim().toLocaleLowerCase("it-IT");
const knownAliases = new Set(categoryDefinitions.flatMap(({ aliases }) => aliases));
const categorySections = categoryDefinitions
  .map(({ key, label, aliases }) => ({
    key,
    label,
    posts: posts.filter((post) => aliases.includes(normalizeCategory(post.data.category))),
  }))
  .filter(({ posts }) => posts.length > 0);

const otherCategories = [...new Set(posts.map((post) => post.data.category))]
  .filter((category) => !knownAliases.has(normalizeCategory(category)))
  .map((category) => ({
    key: normalizeCategory(category).replace(/[^a-z0-9]+/g, "-"),
    label: category,
    posts: posts.filter((post) => post.data.category === category),
  }));

const sections = [...categorySections, ...otherCategories];
---

<BaseLayout
  title="News e guide per imprese funebri | Cas-Per"
  description="Notizie e guide su necrologi online, cordogli, strumenti digitali ed evoluzione delle imprese funebri."
  canonical="/news/"
>
  <div class="glass-bg-blobs" aria-hidden="true">
    <div class="blob-circle blob-cyan" style="top: 10%; right: 10%; width: 400px; height: 400px; opacity: 0.15;"></div>
    <div class="blob-circle blob-mauve" style="top: 40%; left: 5%; width: 320px; height: 320px; opacity: 0.12;"></div>
  </div>
  <PageHero
    eyebrow="News"
    title="Strumenti, esperienze e cultura digitale per imprese funebri."
    text="Guide concrete per orientarsi tra annunci online, cordogli, comunicazione con le famiglie e servizi digitali."
  />

  <section class="section news-index-section">
    <div class="section-inner news-category-list">
      {
        posts.length > 0 ? (
          sections.map((section) => (
            <details class="news-category">
              <summary class="news-category-header">
                <span class="news-category-title" id={`category-${section.key}`}>{section.label}</span>
                <span class="news-category-count" aria-label={`${section.posts.length} articoli`}>
                  {section.posts.length.toString().padStart(2, "0")}
                </span>
              </summary>
              <div class="article-grid category-article-grid" aria-labelledby={`category-${section.key}`}>
                {section.posts.map((post) => (
                  <ArticleCard
                    title={post.data.title}
                    description={post.data.description}
                    category={post.data.category}
                    publishedAt={post.data.publishedAt}
                    href={`/news/${post.id}/`}
                    image={post.data.image}
                    imageAlt={post.data.imageAlt}
                    showDate={post.data.showDate}
                    showCategory={false}
                  />
                ))}
              </div>
            </details>
          ))
        ) : (
          <div class="empty-state">
            <p class="eyebrow">In preparazione</p>
            <h2>Le prime notizie stanno arrivando.</h2>
            <p>Partiremo da AnnunciFunebri.it, dalla raccolta dei cordogli e dal ruolo del digitale nel lavoro quotidiano dell'impresa funebre.</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
