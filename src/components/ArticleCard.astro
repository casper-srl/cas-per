---
interface Props {
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  href: string;
  image: string;
  imageAlt: string;
  showDate?: boolean;
  showCategory?: boolean;
}

const {
  title,
  description,
  category,
  publishedAt,
  href,
  image,
  imageAlt,
  showDate = true,
  showCategory = true,
} = Astro.props;
const formattedDate = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(publishedAt);
const meta = [showCategory ? category : null, showDate ? formattedDate : null].filter(Boolean).join(" · ");
const isEvent = ["evento", "eventi"].includes(category.trim().toLocaleLowerCase("it-IT"));
---

<article class:list={["article-card", isEvent && "article-card-event"]}>
  <a class="article-card-image" href={href} aria-label={`Leggi ${title}`}>
    <img src={image} alt={imageAlt} loading="lazy" />
  </a>
  <div class="article-card-body">
    {meta && <p class="eyebrow">{meta}</p>}
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    <a class="text-link" href={href}>Leggi l'articolo</a>
  </div>
</article>
